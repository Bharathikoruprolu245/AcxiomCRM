@model IEnumerable<AcxiomCRM.Models.Lead>
@{ViewData["Title"]="Leads";}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Leads</h2><a asp-action="Create" class="btn btn-primary">+ Add Lead</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search lead or company"/></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(string s in ViewBag.Statuses){<option selected="@(ViewBag.Status==s)" value="@s">@s</option>}</select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Status</th><th>Priority</th><th>Expected Value</th><th>Assigned To</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.LeadCode</td><td><a asp-action="Details" asp-route-id="@x.LeadId">@x.LeadName</a></td><td>@x.CompanyName</td><td>@x.Status</td><td>@x.Priority</td><td>@x.ExpectedValue.ToString("C")</td><td>@x.AssignedTo</td><td><a asp-action="Edit" asp-route-id="@x.LeadId" class="btn btn-sm btn-outline-primary">Edit</a></td></tr>}</tbody></table></div>
@if(!Model.Any()){<p class="text-muted">No leads found.</p>}
