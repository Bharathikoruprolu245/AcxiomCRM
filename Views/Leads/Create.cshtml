@model AcxiomCRM.Models.Lead
@{var editing=ViewContext.RouteData.Values["action"]?.ToString()=="Edit";ViewData["Title"]=editing?"Edit Lead":"Create Lead";}
<h2>@ViewData["Title"]</h2><form asp-action="@(editing?"Edit":"Create")" asp-route-id="@Model.LeadId" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row">
<div class="col-md-6 mb-3"><label asp-for="LeadCode" class="form-label"></label><input asp-for="LeadCode" class="form-control" readonly="@editing"/><span asp-validation-for="LeadCode" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" class="form-control"/><span asp-validation-for="LeadName" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" maxlength="10" inputmode="numeric"/><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control"/></div>
<div class="col-md-6 mb-3"><label asp-for="Source" class="form-label"></label><select asp-for="Source" class="form-select"><option value="">Choose source</option><option>Website</option><option>Referral</option><option>Campaign</option><option>Cold Call</option><option>Other</option></select></div>
<div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach(string s in ViewBag.Statuses){<option value="@s">@s</option>}</select><span asp-validation-for="Status" class="text-danger"></span>@if(editing){<small class="text-muted">Current status: @ViewBag.OriginalStatus. Only configured transitions are accepted.</small>}</div>
<div class="col-md-4 mb-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select"><option>Low</option><option>Medium</option><option>High</option></select></div>
<div class="col-md-4 mb-3"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" class="form-control" type="number" min="0" step=".01"/><span asp-validation-for="ExpectedValue" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="AssignedTo" class="form-label">Assigned sales executive (email)</label><input asp-for="AssignedTo" class="form-control" readonly="@User.IsInRole(AcxiomCRM.Models.Roles.SalesExecutive)"/></div>
<div class="col-12 mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div></div>
<button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
