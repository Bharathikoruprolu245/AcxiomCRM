@model AcxiomCRM.Models.Lead
@{ViewData["Title"]="Lead Details";}
<div class="d-flex justify-content-between"><h2>@Model.LeadName</h2><a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary">Edit</a></div>
<dl class="row mt-3"><dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.LeadCode</dd><dt class="col-sm-3">Email / Phone</dt><dd class="col-sm-9">@Model.Email / @Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Priority</dt><dd class="col-sm-9">@Model.Priority</dd><dt class="col-sm-3">Expected Value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C")</dd><dt class="col-sm-3">Assigned To</dt><dd class="col-sm-9">@Model.AssignedTo</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl>
@if(Model.Status=="Qualified"){<form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" onsubmit="return confirm('Convert this qualified lead to a customer and opportunity?')"><button class="btn btn-success">Convert Lead</button></form>}
<a asp-action="Index" class="btn btn-outline-secondary mt-2">Back</a>
