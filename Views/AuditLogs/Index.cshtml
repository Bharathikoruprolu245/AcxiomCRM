@model IEnumerable<AcxiomCRM.Models.AuditLog>
@{ViewData["Title"]="Audit Log";}
<h2 class="mb-3">Audit Log</h2>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><input name="user" value="@ViewBag.UserFilter" class="form-control" placeholder="User email / ID"/></div><div class="col-md-2"><select name="module" class="form-select"><option value="">All modules</option>@foreach(string s in new[]{"Authentication","User","Customer","Lead","Opportunity","FollowUp","Activity"}){<option value="@s" selected="@(ViewBag.Module==s)">@s</option>}</select></div><div class="col-md-2"><input name="action" value="@ViewBag.Action" class="form-control" placeholder="Action"/></div><div class="col-md-2"><input name="from" type="date" value="@ViewBag.From" class="form-control"/></div><div class="col-md-2"><input name="to" type="date" value="@ViewBag.To" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Module</th><th>Record</th><th>Result</th><th>IP</th><th>Details</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@x.UserName</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.RecordId</td><td>@x.Result</td><td>@x.IpAddress</td><td>@x.OldValue → @x.NewValue</td></tr>}</tbody></table></div>
@if(!Model.Any()){<p class="text-muted">No audit entries match those filters.</p>}
