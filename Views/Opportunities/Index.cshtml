@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{ViewData["Title"]="Opportunities";}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Opportunities</h2><a asp-action="Create" class="btn btn-primary">+ Add Opportunity</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search opportunity or customer"/></div><div class="col-md-3"><select name="stage" class="form-select"><option value="">All stages</option>@foreach(string s in ViewBag.Stages){<option value="@s" selected="@(ViewBag.Stage==s)">@s</option>}</select></div><div class="col-md-2"><select name="status" class="form-select"><option value="">All statuses</option><option value="Open" selected="@(ViewBag.Status=="Open")">Open</option><option value="Won" selected="@(ViewBag.Status=="Won")">Won</option><option value="Lost" selected="@(ViewBag.Status=="Lost")">Lost</option></select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Status</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close Date</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a asp-action="Details" asp-route-id="@x.OpportunityId">@x.OpportunityName</a></td><td>@x.Customer?.CustomerName</td><td>@x.Stage</td><td>@x.Status</td><td>@x.Amount.ToString("C")</td><td>@x.Probability%</td><td>@x.WeightedAmount.ToString("C")</td><td>@x.ExpectedCloseDate.ToString("yyyy-MM-dd")</td><td><a asp-action="Edit" asp-route-id="@x.OpportunityId" class="btn btn-sm btn-outline-primary">Edit</a></td></tr>}</tbody></table></div>
@if(!Model.Any()){<p class="text-muted">No opportunities found.</p>}
