@using AcxiomCRM.Controllers
@model object
@{ViewData["Title"]="Reports";}
<h2 class="mb-3">Reports</h2>
<form method="get" class="row g-2 mb-4"><div class="col-md-3"><label class="form-label">Report</label><select name="report" class="form-select"><option value="pipeline" selected="@(ViewBag.Report=="pipeline")">Sales Pipeline</option><option value="customers" selected="@(ViewBag.Report=="customers")">Customers</option><option value="leads" selected="@(ViewBag.Report=="leads")">Leads / Conversion</option><option value="opportunities" selected="@(ViewBag.Report=="opportunities")">Opportunities</option><option value="followups" selected="@(ViewBag.Report=="followups")">Follow-Ups</option><option value="users" selected="@(ViewBag.Report=="users")">User Activity</option><option value="audit" selected="@(ViewBag.Report=="audit")">Audit Activity</option></select></div><div class="col-md-3"><label class="form-label">From</label><input type="date" name="from" value="@ViewBag.From" class="form-control"/></div><div class="col-md-3"><label class="form-label">To</label><input type="date" name="to" value="@ViewBag.To" class="form-control"/></div><div class="col-md-2"><label class="form-label">Status</label><input name="status" value="@ViewBag.Status" class="form-control" placeholder="Optional"/></div><div class="col-auto align-self-end"><button class="btn btn-primary">Run Report</button></div></form>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Customers created</div><h3>@ViewBag.CustomerCount</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Leads created</div><h3>@ViewBag.LeadCount</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Converted leads</div><h3>@ViewBag.ConvertedCount</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted">Overdue follow-ups</div><h3>@ViewBag.Overdue</h3></div></div></div></div>
@if(ViewBag.Report=="pipeline"){
<h4>Open Pipeline by Stage and Owner</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Stage</th><th>Owner</th><th>Count</th><th>Amount</th><th>Weighted Amount</th></tr></thead><tbody>@foreach(var x in (IEnumerable<ReportsController.PipelineRow>)ViewBag.Pipeline){<tr><td>@x.Stage</td><td>@x.Owner</td><td>@x.Count</td><td>@x.Amount.ToString("C")</td><td>@x.Weighted.ToString("C")</td></tr>}</tbody></table></div>
}else if(ViewBag.Report=="customers"){
<h4>Customer Report</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Customer</th><th>Status</th><th>Owner</th><th>Created</th></tr></thead><tbody>@foreach(var x in (IEnumerable<AcxiomCRM.Models.Customer>)ViewBag.Customers){<tr><td>@x.CustomerName</td><td>@x.Status</td><td>@x.AssignedTo</td><td>@x.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div>
}else if(ViewBag.Report=="leads"){
<h4>Lead and Conversion Report</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Lead</th><th>Source</th><th>Status</th><th>Owner</th><th>Expected Value</th></tr></thead><tbody>@foreach(var x in (IEnumerable<AcxiomCRM.Models.Lead>)ViewBag.Leads){<tr><td>@x.LeadName</td><td>@x.Source</td><td>@x.Status</td><td>@x.AssignedTo</td><td>@x.ExpectedValue.ToString("C")</td></tr>}</tbody></table></div>
}else if(ViewBag.Report=="opportunities"){
<h4>Opportunity Report</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Status</th><th>Amount</th><th>Probability</th><th>Close Date</th></tr></thead><tbody>@foreach(var x in (IEnumerable<AcxiomCRM.Models.Opportunity>)ViewBag.Opportunities){<tr><td>@x.OpportunityName</td><td>@x.Customer?.CustomerName</td><td>@x.Stage</td><td>@x.Status</td><td>@x.Amount.ToString("C")</td><td>@x.Probability%</td><td>@x.ExpectedCloseDate.ToString("yyyy-MM-dd")</td></tr>}</tbody></table></div>
}else if(ViewBag.Report=="followups"){
<h4>Follow-Up Report</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Date</th><th>Subject</th><th>Customer / Lead</th><th>Status</th><th>Type</th><th>Owner</th></tr></thead><tbody>@foreach(var x in (IEnumerable<AcxiomCRM.Models.FollowUp>)ViewBag.FollowUpRows){<tr><td>@x.FollowUpDate.ToString("yyyy-MM-dd")</td><td>@x.Subject</td><td>@(x.Customer?.CustomerName??x.Lead?.LeadName??(x.OpportunityId.HasValue?"Opportunity #"+x.OpportunityId:"—"))</td><td>@x.Status</td><td>@x.FollowUpType</td><td>@x.AssignedTo</td></tr>}</tbody></table></div>
}else if(ViewBag.Report=="users"){
<h4>User Activity Report</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>User</th><th>Action Count</th><th>Last Activity</th></tr></thead><tbody>@foreach(var x in (IEnumerable<ReportsController.UserActivityRow>)ViewBag.UserActivity){<tr><td>@x.UserName</td><td>@x.ActionCount</td><td>@x.LastActivity.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div>
}else{
<h4>Recent Audit Activity</h4><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Module</th><th>Result</th></tr></thead><tbody>@foreach(var x in (IEnumerable<AcxiomCRM.Models.AuditLog>)ViewBag.Audit){<tr><td>@x.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@x.UserName</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.Result</td></tr>}</tbody></table></div>
}
