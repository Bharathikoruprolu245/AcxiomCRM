@model IEnumerable<AcxiomCRM.Models.Activity>
@{ViewData["Title"]="Activities";}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Activities</h2><a asp-action="Create" class="btn btn-primary">+ Add Activity</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="type" class="form-select"><option value="">All types</option>@foreach(string s in AcxiomCRM.Models.ActivityTypes.All){<option value="@s" selected="@(ViewBag.Type==s)">@s</option>}</select></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(string s in new[]{"Planned","Completed","Cancelled"}){<option value="@s" selected="@(ViewBag.Status==s)">@s</option>}</select></div><div class="col-md-3"><input name="date" type="date" value="@ViewBag.Date" class="form-control"/></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Related To</th><th>Status</th><th>Assigned To</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.ActivityDate.ToString("yyyy-MM-dd")</td><td>@x.ActivityType</td><td>@x.Subject</td><td>@(x.Customer?.CustomerName??x.Lead?.LeadName??"—")</td><td>@x.Status</td><td>@x.AssignedTo</td><td><a asp-action="Edit" asp-route-id="@x.ActivityId" class="btn btn-sm btn-outline-primary">Edit</a></td></tr>}</tbody></table></div>
@if(!Model.Any()){<p class="text-muted">No activities found.</p>}
