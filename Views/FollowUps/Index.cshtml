@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{ViewData["Title"]="Follow-Ups";}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Follow-Ups</h2><a asp-action="Create" class="btn btn-primary">+ Schedule Follow-Up</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(string s in AcxiomCRM.Models.FollowUpStatuses.All){<option value="@s" selected="@(ViewBag.Status==s)">@s</option>}</select></div><div class="col-md-3"><input name="from" type="date" value="@ViewBag.From" class="form-control" aria-label="From date"/></div><div class="col-md-3"><input name="to" type="date" value="@ViewBag.To" class="form-control" aria-label="To date"/></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Date</th><th>Subject</th><th>Related to</th><th>Type</th><th>Status</th><th>Assigned To</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr class="@(x.Status=="Planned"&&x.FollowUpDate.Date<DateTime.Today?"table-warning":"")"><td>@x.FollowUpDate.ToString("yyyy-MM-dd")</td><td>@x.Subject</td><td>@(x.Customer?.CustomerName ?? x.Lead?.LeadName ?? (x.OpportunityId.HasValue?"Opportunity #"+x.OpportunityId:"—"))</td><td>@x.FollowUpType</td><td>@x.Status</td><td>@x.AssignedTo</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@x.FollowUpId" class="btn btn-sm btn-outline-primary">Edit / Reschedule</a> @if(x.Status=="Planned"){<form asp-action="Complete" asp-route-id="@x.FollowUpId" method="post" class="d-inline"><button class="btn btn-sm btn-success">Complete</button></form>}</td></tr>}</tbody></table></div>
@if(!Model.Any()){<p class="text-muted">No follow-ups found.</p>}
