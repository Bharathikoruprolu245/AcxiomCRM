@model IEnumerable<AcxiomCRM.Controllers.UsersController.UserRow>
@{ViewData["Title"]="Users & Roles";}
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Users &amp; Roles</h2><a asp-action="Create" class="btn btn-primary">+ Create User</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name or email"/></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Lockout</th><th>Actions</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td>@u.Role</td><td><span class="badge @(u.IsActive?"text-bg-success":"text-bg-secondary")">@(u.IsActive?"Active":"Inactive")</span></td><td>@(u.LockedOut?"Locked":"—")</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Edit</a><form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(u.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div>
