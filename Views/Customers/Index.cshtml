@model IEnumerable<AcxiomCRM.Models.Customer>
@{ ViewData["Title"]="Customers"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Customers</h2><a class="btn btn-primary" asp-action="Create">+ Add Customer</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name, email, phone or company"/></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><option selected="@(ViewBag.Status=="Active")">Active</option><option selected="@(ViewBag.Status=="Inactive")">Inactive</option></select></div><div class="col-auto"><button class="btn btn-outline-primary">Search</button></div></form>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th>Status</th><th>Owner</th><th></th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.CustomerCode</td><td><a asp-action="Details" asp-route-id="@x.CustomerId">@x.CustomerName</a></td><td>@x.CompanyName</td><td>@x.Email</td><td>@x.Phone</td><td><span class="badge @(x.Status=="Active"?"text-bg-success":"text-bg-secondary")">@x.Status</span></td><td>@x.AssignedTo</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.CustomerId">Edit</a> @if(x.Status=="Active"){<form asp-action="Delete" asp-route-id="@x.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Deactivate this customer?')"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form>}</td></tr>}
</tbody></table></div>
@if(!Model.Any()){<p class="text-muted">No customers found.</p>}
