@model AcxiomCRM.Models.Customer
@{ViewData["Title"]="Customer Details";}
<div class="d-flex justify-content-between"><h2>@Model.CustomerName</h2><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit</a></div>
<dl class="row mt-3"><dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.CustomerCode</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.State</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.AssignedTo</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime()</dd></dl>
<a asp-action="Index" class="btn btn-outline-secondary">Back</a>
